{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "nodeVersion": "20.x",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "VITE_DISABLE_AUTH": "true",
    "VITE_API_BASE": "https://cortex-backend-9hk0.onrender.com"
  }
}
